{
  "name": "locacar",
  "version": "1.0.0",
  "description": "Multi-agency car rental management system",
  "main": "src/backend/index.ts",
  "scripts": {
    "start": "node serve.js",
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend:dev": "tsx watch src/backend/index.ts",
    "frontend:dev": "vite --config src/frontend/vite.config.ts",
    "mobile:dev": "react-native start",
    "build": "npm run build:backend && npm run build:frontend && npm run build:mobile",
    "build:backend": "tsc --project src/backend/tsconfig.json",
    "build:frontend": "vite build --config src/frontend/vite.config.ts",
    "build:mobile": "eas build --platform all",
    "test": "jest",
    "test:backend": "jest src/backend",
    "test:frontend": "jest src/frontend",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "db:migrate": "ts-node src/backend/scripts/migrate.ts",
    "db:seed": "ts-node src/backend/scripts/seed.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "multer": "^2.2.0",
    "pg": "^8.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-query": "^3.39.3",
    "react-redux": "^8.1.0",
    "react-router-dom": "^6.11.0",
    "redis": "^4.6.0",
    "redux": "^4.2.0",
    "socket.io": "^4.6.0",
    "tsx": "^3.12.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "docker-compose": "^0.23.17",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vite": "^4.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "car-rental",
    "fleet-management",
    "invoicing",
    "gps-tracking",
    "multi-agency"
  ],
  "author": "LocaCar Team",
  "license": "PROPRIETARY"
}
